digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Numerical prediction paths",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "four lagged levels and masks" -> "training-only scaling"; "training-only scaling" -> "shared tanh hidden layer"; "shared tanh hidden layer" -> "six mean / log variance heads"; "six mean / log variance heads" -> "masked weighted Gaussian loss"; "masked weighted Gaussian loss" -> "analytic gradients and Adam"; "validation residuals" -> "90 percent calibration quantiles"; "count design and offset" -> "negative-binomial IRLS"; "negative-binomial IRLS" -> "seasonal state count scenario"; }
