digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Three different questions",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "measured panel" -> {"description" "prediction" "candidate causal design"}; "description" -> "matched endpoint changes"; "prediction" -> "pre-2020 extrapolation and forecast bands"; "candidate causal design" -> "eligibility / pretrends / placebo / interference"; "eligibility / pretrends / placebo / interference" -> "identification not established"; {"matched endpoint changes" "pre-2020 extrapolation and forecast bands" "identification not established"} -> "distinct atlas labels"; }
