digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Independent semantic verification",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "trusted Git source" -> "per-file source identities"; "frozen raw bytes" -> "independent measurement parser"; "per-file source identities" -> "verifier"; "independent measurement parser" -> "verifier"; "saved parameters and frozen probes" -> "direct NumPy replay"; "direct NumPy replay" -> "verifier"; "rehashed semantic mutations" -> "verifier subprocess"; "verifier subprocess" -> "required semantic rejection reason"; "verifier" -> "diagnostic result; full gates remain separate"; }
