digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Additive crosswalk contract",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "source count and source denominator" -> "weights sum to one per source"; "weights sum to one per source" -> {"target A count" "target B count"}; "allocation lower / upper" -> {"target A count" "target B count"} [style=dashed]; {"target A count" "target B count"} -> "recompute rate with matched denominator"; "unknown historical split" -> "unresolved geography gate" [color="#a05a37"]; }
