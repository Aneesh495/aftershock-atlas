digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Persistent artifact lifecycle",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "source bytes" -> "raw source receipt"; "raw source receipt" -> "panel manifest"; "panel manifest" -> "feature population identities"; "feature population identities" -> "initial checkpoint"; "initial checkpoint" -> "optimizer restart checkpoint"; "optimizer restart checkpoint" -> "best validation checkpoint"; "best validation checkpoint" -> "frozen prediction records"; "frozen prediction records" -> "new evidence run directory"; "new evidence run directory" -> "verified preview receipt"; }
