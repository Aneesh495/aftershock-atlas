digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Identity and coverage inventory",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "WHO reporting areas" -> "surveillance coverage"; "WDI economies and territories" -> "annual metric coverage"; "US source-defined adult groups" -> "survey coverage: US only"; "UK opt-in devices" -> "mobility coverage: UK only"; "HGI aggregate cases and controls" -> "selected variant coverage"; "CDC weighted sequencing" -> "viral coverage: US only"; {"surveillance coverage" "annual metric coverage" "survey coverage: US only" "mobility coverage: UK only" "selected variant coverage" "viral coverage: US only"} -> "independent counts in atlas"; }
