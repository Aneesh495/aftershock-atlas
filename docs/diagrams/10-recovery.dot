digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Interruption and recovery",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "acquire lock" -> "bounded temporary download"; "bounded temporary download" -> "hash and atomic commit" [label="success"]; "bounded temporary download" -> "delete partial / retain prior" [label="failure"]; "delete partial / retain prior" -> "retry only missing source"; "optimizer batch" -> "atomic RNG and moment checkpoint"; "atomic RNG and moment checkpoint" -> "identity check on resume"; "identity check on resume" -> "same next sampler and update"; "identity check on resume" -> "reject changed data or protocol" [label="mismatch"]; }
