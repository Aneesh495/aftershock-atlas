digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Event time and acquisition time",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "2020 report week" -> "2023 retrospective correction" [label="same event identity"]; "2023 retrospective correction" -> "2026 acquired bytes"; "2026 acquired bytes" -> "available_at = acquisition bound"; "2015 annual reference year" -> "2026 acquired bytes" [label="does not establish 2015 availability"]; "available_at = acquisition bound" -> "historical as-of query"; "historical as-of query" -> "missing historical vintage" [label="return absent, never final fallback"]; }
