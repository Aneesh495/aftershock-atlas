digraph Atlas {
 graph [rankdir=LR,bgcolor="white",pad="0.3",fontname="Helvetica",label="Survey estimation and disclosure",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10];
 edge [color="#64836a",fontname="Helvetica",fontsize=8];
 "NCHS released aggregates" -> "phase and reference period" -> "within-phase contrasts" -> "published interval envelope" -> "disclosure boundary";
 "Census week 1 public-use ZIP" -> "in-memory keyed join";
