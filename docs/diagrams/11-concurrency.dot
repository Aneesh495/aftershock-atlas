digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Bounded runtime concurrency",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "serial source requests" -> "one source partition at a time"; "Arrow batches: 8192 rows" -> "DuckDB: 2 threads / 512 MB"; "DuckDB: 2 threads / 512 MB" -> "spill <= 256 MB"; "local HTTP socket queue: 16" -> "active request slots: 8"; "active request slots: 8" -> "15 second socket timeout"; "active request slots: 8" -> "503 when saturated"; "browser outcome change" -> "AbortController cancels stale fetch"; }
