digraph Atlas { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",fontname="Helvetica",label="Forecast information sets",labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#eef3e9",color="#819880",fontname="Helvetica",fontsize=10,margin="0.14,0.1"]; edge [color="#64836a",fontname="Helvetica",fontsize=8]; "country identifier SHA256" -> {"training countries" "held-out countries"}; "training countries" -> "2004-2015 fit"; "2004-2015 fit" -> "normalization and Adam"; "training countries" -> "2016-2018 validation"; "2016-2018 validation" -> "stopping / calibration / baseline choice"; {"normalization and Adam" "stopping / calibration / baseline choice"} -> "frozen 2019-2024 inference"; "held-out countries" -> "frozen 2019-2024 inference"; "frozen 2019-2024 inference" -> "per-family proper scores and drift"; }
